{
  "name": "@music/api", "private": true, "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts", "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js", "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate", "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": { "@prisma/client": "6.19.0", "dotenv": "^17.2.3", "express": "^5.1.0", "helmet": "^8.1.0" },
  "devDependencies": { "@types/express": "^5.0.5", "@types/node": "^22.19.0", "@types/supertest": "^6.0.3", "prisma": "6.19.0", "supertest": "^7.1.4", "tsx": "^4.20.6" }
}
