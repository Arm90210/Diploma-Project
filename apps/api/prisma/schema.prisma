generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DataOrigin {
  REAL
  SYNTHETIC
}

enum DiscoverySource {
  CATALOG
  SEARCH
  PLAYLIST
  RECOMMENDATION
  REGIONAL_CHART
}

model Region {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(40)
  name        String           @db.VarChar(120)
  countryCode String           @db.Char(2)
  parentId    String?          @db.Uuid
  parent      Region?          @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Region[]         @relation("RegionHierarchy")
  users       User[]
  events      ListeningEvent[]

  @@index([countryCode])
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  email             String           @unique @db.VarChar(254)
  username          String           @unique @db.VarChar(40)
  displayName       String           @db.VarChar(100)
  sessions          Session[]
  passwordHash      String
  regionId          String?          @db.Uuid
  locationConsentAt DateTime?        @db.Timestamptz(3)
  dataOrigin        DataOrigin       @default(REAL)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  region            Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)
  tracks            Track[]
  playlists         Playlist[]
  likes             Like[]
  events            ListeningEvent[]
  playbackSessions  PlaybackSession[]
}

model Artist {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @db.VarChar(150)
  tracks Track[]

  @@index([name])
}

model Track {
  id              String           @id @default(uuid()) @db.Uuid
  // Stable public identifier (e.g. "study-0"); UUID stays the primary key.
  slug            String           @unique @db.VarChar(80)
  title           String           @db.VarChar(200)
  artistId        String           @db.Uuid
  // Null for platform-curated catalog tracks (seeded demo studies).
  uploaderId      String?          @db.Uuid
  durationMs      Int
  audioKey        String           @unique
  coverKey        String?
  rightsStatement String
  dataOrigin      DataOrigin       @default(REAL)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Restrict)
  uploader        User?            @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  genres          TrackGenre[]
  playlists       PlaylistTrack[]
  likes           Like[]
  events          ListeningEvent[]
  playbackSessions PlaybackSession[]

  @@index([artistId])
  @@index([uploaderId])
  @@index([createdAt])
  @@index([title])
}

model Genre {
  id     String       @id @default(uuid()) @db.Uuid
  name   String       @unique @db.VarChar(80)
  tracks TrackGenre[]
}

model TrackGenre {
  trackId String @db.Uuid
  genreId String @db.Uuid
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([trackId, genreId])
  @@index([genreId])
}

model Playlist {
  id        String          @id @default(uuid()) @db.Uuid
  ownerId   String          @db.Uuid
  title     String          @db.VarChar(150)
  isPublic  Boolean         @default(false)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]

  @@index([ownerId])
}

model PlaylistTrack {
  playlistId String   @db.Uuid
  trackId    String   @db.Uuid
  position   Int
  addedAt    DateTime @default(now()) @db.Timestamptz(3)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@unique([playlistId, position])
  @@index([trackId])
}

model Like {
  userId    String   @db.Uuid
  trackId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([trackId, createdAt])
}

// Qualified listens only. Unqualified playback heartbeats are not retained here.
// The API will issue the session UUID and derive user, timestamp, duration, and region.
model ListeningEvent {
  id                String          @id @default(uuid()) @db.Uuid
  playbackSessionId String          @unique @db.Uuid
  userId            String          @db.Uuid
  trackId           String          @db.Uuid
  occurredAt        DateTime        @default(now()) @db.Timestamptz(3)
  listenedMs        Int
  completionRatio   Float
  regionId          String?         @db.Uuid
  source            DiscoverySource
  dataOrigin        DataOrigin      @default(REAL)
  // Listening policy that produced the event (e.g. "listen-v1").
  policyVersion     String          @default("unversioned") @db.VarChar(20)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  track             Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  region            Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([dataOrigin, occurredAt])
  @@index([dataOrigin, trackId, occurredAt])
  @@index([dataOrigin, regionId, occurredAt])
  @@index([userId, occurredAt])
  @@index([userId, trackId, occurredAt])
}

// Server-issued playback session: partial progress before (and after) a listen qualifies.
model PlaybackSession {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  trackId          String          @db.Uuid
  source           DiscoverySource
  policyVersion    String          @db.VarChar(20)
  startedAt        DateTime        @default(now()) @db.Timestamptz(3)
  lastHeartbeatAt  DateTime?       @db.Timestamptz(3)
  lastSequence     Int             @default(0)
  lastPositionMs   Int?
  lastPlaying      Boolean         @default(false)
  accumulatedMs    Int             @default(0)
  // Sorted, disjoint [startMs, endMs) intervals of the track timeline actually heard.
  coveredIntervals Json            @default("[]")
  qualifiedAt      DateTime?       @db.Timestamptz(3)
  endedAt          DateTime?       @db.Timestamptz(3)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  track            Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([trackId])
}

// Store SHA-256 of a random token; the raw token belongs only in the cookie.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
